NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker
JWT_ACCESS_SECRET=generate_with_node_-e_crypto.randomBytes(48)_min_32_chars
JWT_REFRESH_SECRET=must_differ_from_access_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_COST=12
LOG_LEVEL=info
